# SplitSmart Environment Configuration Template
# Duplicate this file as .env and fill in your keys when connecting real backends.

# Application Defaults
VITE_APP_NAME=SplitSmart
VITE_APP_TAGLINE="Scan. Split. Settle."
VITE_DEFAULT_CURRENCY=INR

# Google Gemini Vision & Multimodal API
# Get your API key from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Developer Sandbox (https://developer.paypal.com/)
# Used for peer-to-peer sandbox settlement verification
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
VITE_PAYPAL_ENV=sandbox

# Supabase Backend & Database (PostgreSQL + Realtime Auth)
# Get credentials from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

